{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovidhan.net/schemas/bcs-candidate-intelligence-v1.schema.json",
  "title": "Ovidhan BCS Candidate Intelligence V1",
  "description": "Provenance-first BCS exam, journey, revision, and privacy-safe anonymous candidate-state contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_policy", "journey_stages", "exam_records", "candidate_state_contract", "analytics_contract", "watcher_contract"],
  "properties": {
    "schema_version": { "const": 1 },
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classifications", "candidate_facing_publishable", "priority_order"],
      "properties": {
        "classifications": { "type": "array", "uniqueItems": true, "items": { "enum": ["OFFICIAL_BPSC", "OFFICIAL_GOVERNMENT", "TRUSTED_SECONDARY", "UNVERIFIED_SECONDARY", "UNKNOWN"] } },
        "candidate_facing_publishable": { "type": "array", "uniqueItems": true, "items": { "enum": ["OFFICIAL_BPSC", "OFFICIAL_GOVERNMENT"] } },
        "priority_order": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "journey_stages": {
      "type": "array", "minItems": 11, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["stage_id", "label_en", "label_bn", "description", "actions", "previous_stage_ids", "next_stage_ids", "preparation_type", "learning_cta", "provenance_requirement"],
        "properties": {
          "stage_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "label_en": { "type": "string", "minLength": 1 }, "label_bn": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "actions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "previous_stage_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "next_stage_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "preparation_type": { "enum": ["APPLICATION", "PRELIMINARY", "WRITTEN", "VIVA", "RESULT", "POST_RESULT"] },
          "learning_cta": {
            "oneOf": [
              { "type": "null" },
              { "type": "object", "additionalProperties": false, "required": ["action_id", "href", "optional", "reason"], "properties": { "action_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, "href": { "type": "string", "pattern": "^/" }, "optional": { "const": true }, "reason": { "type": "string", "minLength": 1 } } }
            ]
          },
          "provenance_requirement": { "enum": ["STRUCTURAL_ONLY", "OFFICIAL_SOURCE_REQUIRED"] }
        }
      }
    },
    "exam_records": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["exam_id", "exam_number", "display_name", "exam_type", "status", "dates", "sources", "last_verified_at", "revision", "source_confidence", "notes"],
        "properties": {
          "exam_id": { "type": "string", "pattern": "^bcs-[0-9]+$" }, "exam_number": { "type": "integer", "minimum": 1 },
          "display_name": { "type": "string", "minLength": 1 }, "exam_type": { "const": "BCS" },
          "status": { "enum": ["ANNOUNCED", "APPLICATION_OPEN", "PRELIMINARY", "WRITTEN", "VIVA", "FINAL", "CLOSED", "UNKNOWN"] },
          "dates": { "type": "object", "additionalProperties": { "type": ["string", "null"], "format": "date" } },
          "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
          "last_verified_at": { "type": "string", "format": "date-time" },
          "revision": { "$ref": "#/$defs/revision" },
          "source_confidence": { "enum": ["OFFICIAL", "HIGH", "LIMITED", "UNKNOWN"] },
          "notes": { "type": ["string", "null"] }
        }
      }
    },
    "candidate_state_contract": { "type": "object" },
    "analytics_contract": { "type": "object" },
    "watcher_contract": { "type": "object" }
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "source_type", "source_url", "source_title", "publication_date", "verified_at", "confidence", "superseded"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "source_type": { "enum": ["OFFICIAL_BPSC", "OFFICIAL_GOVERNMENT", "TRUSTED_SECONDARY", "UNVERIFIED_SECONDARY", "UNKNOWN"] },
        "source_url": { "type": "string", "format": "uri" }, "source_title": { "type": "string", "minLength": 1 },
        "publication_date": { "type": ["string", "null"], "format": "date" }, "verified_at": { "type": "string", "format": "date-time" },
        "confidence": { "enum": ["OFFICIAL", "HIGH", "LIMITED", "UNKNOWN"] }, "superseded": { "type": "boolean" }
      }
    },
    "revision": {
      "type": "object", "additionalProperties": false,
      "required": ["version_id", "published_at", "supersedes", "current", "change_summary", "source_id"],
      "properties": {
        "version_id": { "type": "string", "pattern": "^[a-z0-9-]+-v[0-9]+$" }, "published_at": { "type": ["string", "null"], "format": "date-time" },
        "supersedes": { "type": ["string", "null"] }, "current": { "type": "boolean" }, "change_summary": { "type": "string", "minLength": 1 }, "source_id": { "type": "string" }
      }
    }
  }
}
